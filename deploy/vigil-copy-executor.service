[Unit]
Description=Vigil BSC direct-GMGN copy executor (Singapore isolated hot path)
Documentation=file:///opt/vigil-copy-executor/current/docs/sg-copy-executor-runbook.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/vigil-copy-executor/current

# The shipped profile is deliberately non-live. The root-owned EnvironmentFile
# may select observe/shadow; live additionally needs the static risk confirmation
# and the separately installed key/control credential drop-in in the runbook.
Environment=NODE_ENV=production
Environment=COPY_EXECUTOR_MODE=observe
Environment=COPY_EXECUTOR_HOST=127.0.0.1
Environment=COPY_EXECUTOR_PORT=8770
# Deferred durable attempt reservations, cumulative spend/trade audit data, and
# the persistent circuit latch live below StateDirectory. The cumulative values
# are not daily admission gates. Public network dispatch starts before per-target
# fsync; restart reconciliation fails closed on any untracked pending nonce.
# Live startup rejects an empty path.
Environment=COPY_EXECUTOR_RISK_LEDGER_PATH=/var/lib/vigil-copy-executor/risk-ledger.json
Environment=COPY_EXECUTOR_RUNTIME_SETTINGS_PATH=/var/lib/vigil-copy-executor/runtime-settings.json
Environment=COPY_EXECUTOR_POSITION_LEDGER_PATH=/var/lib/vigil-copy-executor/positions.json
# Position/token reads use a free read-only provider first. The execution RPC is
# only a final fallback and still gets a separate client/HTTPS Agent. These
# position-reader time/concurrency bounds are unrelated to copy amount/gas/tip.
Environment=BSC_POSITION_HTTP_RPC_URLS=REDACTED_SECRET
Environment=COPY_EXECUTOR_POSITION_RPC_TIMEOUT_MS=1500
Environment=COPY_EXECUTOR_POSITION_RECONCILE_INTERVAL_MS=15000
Environment=COPY_EXECUTOR_POSITION_RECONCILE_CONCURRENCY=4
EnvironmentFile=/etc/vigil-copy-executor/executor.env

ExecStartPre=/usr/bin/test -r /opt/vigil-copy-executor/current/apps/copy-executor/dist/src/index.js
ExecStartPre=/usr/bin/test -x /usr/bin/flock
# A second unit/copy using the same runtime directory must fail immediately;
# --no-fork leaves Node as MainPID while the inherited descriptor holds the lock.
ExecStart=/usr/bin/flock --exclusive --nonblock --no-fork /run/vigil-copy-executor/executor.lock /usr/bin/node /opt/vigil-copy-executor/current/apps/copy-executor/dist/src/index.js
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=15s
KillSignal=SIGTERM

# systemd creates/chowns the private state path for this unit's DynamicUser on
# every start. Do not replace the ledger with an ad-hoc root-owned file.
StateDirectory=vigil-copy-executor
StateDirectoryMode=0700
RuntimeDirectory=vigil-copy-executor
RuntimeDirectoryMode=0700
UMask=0077

# The executor has its own process and cgroup. It never depends on vigil-relay.
CPUWeight=900
IOWeight=200
Nice=-5
OOMScoreAdjust=-500
MemoryHigh=384M
MemoryMax=512M
TasksMax=128
LimitNOFILE=65536

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# V8 uses executable JIT mappings, so MemoryDenyWriteExecute cannot be enabled
# for this Node.js process without changing the runtime/build strategy.
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
