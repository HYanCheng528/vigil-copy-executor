{
  "name": "@vigil/copy-executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "benchmark:hotpath": "node scripts/benchmark-public-hotpath.mjs",
    "blockrazor:oneoff": "node dist/src/blockrazor-oneoff.js",
    "contract:compile": "node scripts/compile-contract.mjs",
    "contract:test": "node --test \"test/contract-compile.test.mjs\"",
    "executor:deploy": "node scripts/deploy-executors.mjs",
    "roundtrip:ai": "node scripts/roundtrip-gmgn.mjs",
    "risk:status": "node dist/src/risk-cli.js status",
    "risk:clear-circuit": "node dist/src/risk-cli.js clear-circuit",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "ethers": "^6.15.0",
    "protobufjs": "^8.7.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "solc": "0.8.30",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
